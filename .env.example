# Server
PORT=3107
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3107
# Production demo: PUBLIC_BASE_URL=https://forge.stagespace.ai

# Production safety (see README)
# In production you must set APP_AUTH_TOKEN and/or ALLOW_DEMO_MODE=true
ALLOW_DEMO_MODE=false
APP_AUTH_TOKEN=

# Scraping — self-hosted Firecrawl or https://api.firecrawl.dev
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=

# AI summarize + chat — server-side only (never sent to the browser)
FIREWORKS_API=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL_FLASH=accounts/fireworks/models/deepseek-v4-flash

# Reserved for future use — not used by default
GEMINI_API_KEY=

# Daily limits per IP (demo) or per token (private)
AI_DAILY_DEMO_SCRAPE_LIMIT=10
AI_DAILY_DEMO_SUMMARIZE_LIMIT=10
AI_DAILY_DEMO_CHAT_LIMIT=20
AI_DAILY_PRIVATE_SCRAPE_LIMIT=200
AI_DAILY_PRIVATE_SUMMARIZE_LIMIT=100
AI_DAILY_PRIVATE_CHAT_LIMIT=300

# Input caps to control token spend
AI_MAX_INPUT_CHARS=24000
AI_MAX_CHAT_ARTICLE_CHARS=12000
AI_MAX_CHAT_SUMMARY_CHARS=8000
